nano backend/.env.example
APP_NAME=Rent App API
APP_VERSION=2.0.0
ENVIRONMENT=development

# En desarrollo puedes dejar *
# En producción usa dominios concretos separados por coma.
CORS_ORIGINS=*

SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública. Puede usarse en frontend, pero aquí no es obligatoria.
SUPABASE_PUBLISHABLE_KEY=TU_SUPABASE_PUBLISHABLE_KEY

# Clave secreta SOLO BACKEND.
# Puede llamarse sb_secret_xxx o service_role en Supabase.
SUPABASE_SECRET_KEY=TU_SUPABASE_SECRET_KEY
